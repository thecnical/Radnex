#!/usr/bin/env bash
# radnex — launcher.
#
# Starts the LiteLLM -> Logfare proxy if it is not already up, then execs the
# harness. Every argument is forwarded verbatim to `python -m radnex`, so
# `radnex --help`, `radnex -C ~/proj` etc. all work unchanged.
#
# Configure through environment variables only:
#
#   RADNEX_HOME              harness dotdir            (default ~/.radnex)
#   LITELLM_ENV_FILE      profile to source         (default $RADNEX_HOME/logfare/source)
#   LITELLM_PORT          proxy port                (default 4001)
#   LITELLM_SERVICE       proxy manager             (default $RADNEX_HOME/logfare/start-litellm.sh)
#   RADNEX_NO_PROXY=1        never touch the proxy
#   RADNEX_REQUIRE_PROXY=1   hard-fail if the proxy is not healthy
#
# No key is ever printed or logged.

set -euo pipefail

# Diagnostics go to stderr so piped/redirected runs stay parseable.
die()  { printf '\033[31m[radnex]\033[0m %s\n' "$*" >&2; exit 2; }
warn() { printf '\033[33m[radnex]\033[0m %s\n' "$*" >&2; }
info() { printf '\033[36m[radnex]\033[0m %s\n' "$*" >&2; }

# Find the checkout. This launcher lives in <root>/packaging/, so when
# RADNEX_ROOT is not already exported — run.sh and the installed shim both
# export it — the checkout is the parent of this file's directory. readlink -f
# resolves a symlink first, so the same rule holds however it was reached.
_self_dir="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)"
if [[ -z "${RADNEX_ROOT:-}" ]]; then
  if [[ "$(basename -- "$_self_dir")" == "packaging" ]]; then
    RADNEX_ROOT="$(dirname -- "$_self_dir")"
  else
    RADNEX_ROOT="$_self_dir"
  fi
fi

# Resolve the interpreter that carries Radnex's dependencies.
#
# Prefer the checkout's own venv — the one install.sh builds — so a global
# install runs with no activation at all. That is what lets `radnex` work
# from any directory without the operator touching a shell. Failing that, fall
# back to an activated venv ($VIRTUAL_ENV), then a python3 on PATH, which is
# the bring-your-own-venv layout. This script never creates a venv.
if [[ -x "$RADNEX_ROOT/.venv/bin/python" ]]; then
  PY="$RADNEX_ROOT/.venv/bin/python"
elif [[ -n "${VIRTUAL_ENV:-}" && -x "$VIRTUAL_ENV/bin/python" ]]; then
  PY="$VIRTUAL_ENV/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PY="$(command -v python3)"
else
  PY=""
fi

RADNEX_HOME="${RADNEX_HOME:-$HOME/.radnex}"

# Which upstream to use. An explicit environment variable always wins; failing
# that, honour the source last chosen with /cpss-logfare or /cpss-tokenjuice, so
# restarting lands back on whichever one was working. Absent either, Logfare.
_env_override="${LITELLM_ENV_FILE:-}"
_port_override="${LITELLM_PORT:-}"
_svc_override="${LITELLM_SERVICE:-}"

_current_source=""
if [[ -r "$RADNEX_HOME/current-source" ]]; then
  _current_source="$(tr -d '[:space:]' < "$RADNEX_HOME/current-source" 2>/dev/null || true)"
fi

# An endpoint already in the environment wins over everything below.
#
# `source ~/claude-source/haiku-5.5 && radnex` is how the operator points a
# session at a hosted provider, and it has to mean the same thing here as it
# does for Claude Code. The launcher would otherwise source $LITELLM_ENV_FILE,
# whose own ANTHROPIC_BASE_URL would clobber the inherited one — leaving a
# session on the wrong provider with no indication, which is exactly what the
# fail-closed check further down exists to prevent. A *local* inherited URL is
# left on the normal path: that is the ordinary proxy case and still needs the
# profile and the health check.
_inherited_base_url="${ANTHROPIC_BASE_URL:-}"
_skip_profile=0
if [[ -n "$_inherited_base_url" \
      && "$_inherited_base_url" != *"localhost:"* \
      && "$_inherited_base_url" != *"127.0.0.1:"* ]]; then
  _skip_profile=1
  RADNEX_NO_PROXY=1
fi

# Quick flags bypass proxy and profile requirements:
for _arg in "$@"; do
  if [[ "$_arg" == "--setup" || "$_arg" == "--help" || "$_arg" == "-h" || "$_arg" == "--version" || "$_arg" == "--list-models" ]]; then
    _skip_profile=1
    RADNEX_NO_PROXY=1
    break
  fi
done

if [[ "$_skip_profile" != "1" ]]; then
  # The hosted gateways — TokenHarbour, OpenRouter, UnoRouter, AIHubMix, APInex,
  # Radox AI, AntSeed — are remote/hosted: there is no local LiteLLM proxy to start.
  case "$_current_source" in
    antseed)
      if [[ -r "$RADNEX_HOME/antseed/source" ]]; then
        LITELLM_ENV_FILE="${_env_override:-$RADNEX_HOME/antseed/source}"
      fi
      RADNEX_NO_PROXY=1
      # Auto-start local AntSeed buyer on :8377 if not already answering
      _as_port="${ANTSEED_PORT:-8377}"
      if ! curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${_as_port}/v1/models" --max-time 1 2>/dev/null | grep -q "200"; then
        _as_exe=""
        for _cand in "$(command -v antseed || true)" "$HOME/.local/bin/antseed" "$RADNEX_HOME/node/bin/antseed" "$HOME/.npm-global/bin/antseed" "/usr/local/bin/antseed" "/usr/bin/antseed"; do
          if [[ -n "$_cand" && -x "$_cand" ]]; then
            _as_exe="$_cand"
            break
          fi
        done
        if [[ -n "$_as_exe" ]]; then
          mkdir -p "$RADNEX_HOME/antseed"
          info "Starting local AntSeed P2P buyer on :${_as_port}..."
          "$_as_exe" buyer start >> "$RADNEX_HOME/antseed/buyer.log" 2>&1 &
          _as_pid=$!
          trap 'kill $_as_pid 2>/dev/null || true' EXIT INT TERM
          # Wait up to 5s for the buyer to be ready on :8377
          for _i in {1..10}; do
            if curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${_as_port}/v1/models" --max-time 1 2>/dev/null | grep -q "200"; then
              break
            fi
            sleep 0.5
          done
        else
          warn "antseed CLI not found! To enable AntSeed P2P: sudo apt install -y nodejs npm && sudo npm install -g @antseed/cli"
        fi
      fi
      ;;
    tokenharbour|openrouter|unorouter|aihubmix|apinex|radox)
      if [[ -r "$RADNEX_HOME/$_current_source/source" ]]; then
        LITELLM_ENV_FILE="${_env_override:-$RADNEX_HOME/$_current_source/source}"
      fi
      RADNEX_NO_PROXY=1
      ;;
  esac
fi

if [[ "$_current_source" == "tokenjuice" ]]; then
  # Prefer the installed route, which setup.sh populates; fall back to the
  # standalone deepseek-claude layout for a machine that had one before
  # Radnex was installed. Checking the installed copy first is what makes
  # this work on a fresh machine — the old hardcoded $HOME paths only exist on
  # the box where deepseek-claude happened to be installed.
  _tj_profile=""; _tj_service=""
  for _cand in "$RADNEX_HOME/tokenjuice/source:$RADNEX_HOME/tokenjuice/start-litellm.sh" \
               "$HOME/claude-source/deepseek-claude:$HOME/start-litellm.sh"; do
    _p="${_cand%%:*}"; _s="${_cand##*:}"
    if [[ -r "$_p" && -x "$_s" ]]; then
      _tj_profile="$_p"; _tj_service="$_s"; break
    fi
  done
  # Only switch if the Token Juice side is actually installed; otherwise fall
  # through to Logfare rather than dying on a missing profile.
  if [[ -n "$_tj_profile" ]]; then
    LITELLM_ENV_FILE="${_env_override:-$_tj_profile}"
    LITELLM_PORT="${_port_override:-4000}"
    LITELLM_SERVICE="${_svc_override:-$_tj_service}"
    LITELLM_LOG="${LITELLM_LOG:-/tmp/litellm-tj.log}"
  fi
fi

LITELLM_ENV_FILE="${LITELLM_ENV_FILE:-$RADNEX_HOME/logfare/source}"
LITELLM_PORT="${LITELLM_PORT:-4001}"
LITELLM_LOG="${LITELLM_LOG:-/tmp/litellm-radnex.log}"
LITELLM_SERVICE="${LITELLM_SERVICE:-$RADNEX_HOME/logfare/start-litellm.sh}"

RADNEX_NO_PROXY="${RADNEX_NO_PROXY:-0}"
RADNEX_REQUIRE_PROXY="${RADNEX_REQUIRE_PROXY:-0}"

# Keep the checkout's own venv in step with requirements.txt.
#
# install.sh builds $RADNEX_ROOT/.venv once. requirements.txt can still move
# under it — a launch-time update pulls a new one, or the operator edits it —
# and a stale venv then fails the dependency check below on a missing import.
# So reinstall only when the file's content differs from what was last
# installed, recorded in a stamp inside the venv: an ordinary launch pays
# nothing but a hash. Only a venv Radnex owns is touched — a bring-your-own
# venv is left exactly as the operator set it up.
sync_deps() {
  local req="$RADNEX_ROOT/requirements.txt" stamp="$RADNEX_ROOT/.venv/.requirements.sha"
  [[ "$PY" == "$RADNEX_ROOT/.venv/bin/python" && -f "$req" ]] || return 0

  local want=""
  if command -v sha256sum >/dev/null 2>&1; then
    want="$(sha256sum "$req" | cut -d' ' -f1)"
  elif command -v shasum >/dev/null 2>&1; then
    want="$(shasum -a 256 "$req" | cut -d' ' -f1)"
  else
    return 0   # no hasher: leave the venv alone rather than reinstall every launch
  fi
  [[ -r "$stamp" && "$(cat "$stamp" 2>/dev/null)" == "$want" ]] && return 0

  info "dependencies changed — refreshing the venv (one-off)..."
  # pip resolves a bare `-e .` against the CURRENT directory, not against the
  # requirements file it appears in — so this must run from the checkout, or
  # the trailing `-e .` in requirements.txt installs whatever project the
  # operator happened to be standing in. Subshell, so the launch's own cwd is
  # left alone.
  if ( cd "$RADNEX_ROOT" && \
       "$PY" -m pip install --quiet --disable-pip-version-check -r "$req" </dev/null ); then
    printf '%s' "$want" > "$stamp"
    info "venv up to date."
  else
    warn "could not refresh the venv — run $RADNEX_ROOT/install.sh"
  fi
}

# --- preconditions -----------------------------------------------------------

[[ -n "$PY" ]] || die "no python3 on PATH.
       Create a venv, activate it, then install the dependencies:
           python3 -m venv .venv && source .venv/bin/activate
           pip install -r requirements.txt"

# Bring the bundled venv up to date first, so the import check below tests the
# interpreter as it will actually be after this launch, not as it was.
sync_deps

# The dependencies must be importable by THIS interpreter. Checking here turns
# a confusing ImportError at launch into the one command that fixes it. Run
# from / so a stray checkout on sys.path cannot satisfy the import; radnex
# itself is made importable by the PYTHONPATH export below, so only the
# third-party packages are checked.
if ! ( cd / && "$PY" -c 'import anthropic, textual, rich, yaml' ) >/dev/null 2>&1; then
  die "Radnex's dependencies are not installed for $PY
       Create a venv, activate it, then install them:
           python3 -m venv .venv && source .venv/bin/activate
           pip install -r requirements.txt"
fi

# Fail CLOSED. Without the profile, the harness would silently use whatever
# ANTHROPIC_* the shell already exports — a session against the wrong provider
# with no indication anything was off.
if [[ "$RADNEX_NO_PROXY" != "1" && ! -r "$LITELLM_ENV_FILE" ]]; then
  die "profile not found: $LITELLM_ENV_FILE (interpreter: $PY)
       Refusing to run: without it the harness would use whatever ANTHROPIC_*
       variables your shell already exports.
       Fix:  run ./setup.sh, or RADNEX_NO_PROXY=1 radnex ... for a direct endpoint."
fi

# --- load the profile --------------------------------------------------------

_prev_base_url="${ANTHROPIC_BASE_URL:-}"
if [[ "$_skip_profile" != "1" && -r "$LITELLM_ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  . "$LITELLM_ENV_FILE"
  set +a
  if [[ -n "$_prev_base_url" && "$_prev_base_url" != "${ANTHROPIC_BASE_URL:-}" ]]; then
    warn "overriding inherited ANTHROPIC_BASE_URL=$_prev_base_url -> ${ANTHROPIC_BASE_URL:-}"
  fi
fi

# --- only manage a proxy when the profile points at the local one ------------

case "${ANTHROPIC_BASE_URL:-}" in
  *"localhost:${LITELLM_PORT}"*|*"127.0.0.1:${LITELLM_PORT}"*) ;;
  *)
    warn "ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL:-<unset>} is not the local proxy"
    warn "on :${LITELLM_PORT}; skipping the proxy start-up check."
    RADNEX_NO_PROXY=1
    ;;
esac

port_answers() {
  local code
  code="$(curl -s -o /dev/null -w '%{http_code}' \
      "http://127.0.0.1:${LITELLM_PORT}/health/liveliness" --max-time 2 || true)"
  [[ "$code" == "200" ]]
}

ensure_proxy() {
  [[ "$RADNEX_NO_PROXY" == "1" ]] && return 0
  port_answers && return 0

  if [[ ! -x "$LITELLM_SERVICE" ]]; then
    warn "proxy not answering on :${LITELLM_PORT}, and no service manager at"
    warn "$LITELLM_SERVICE. Run ./setup.sh, or set RADNEX_NO_PROXY=1."
    return 1
  fi

  info "LiteLLM proxy not answering on :${LITELLM_PORT} — starting it..."
  # Invoke as a SUBPROCESS, never `source`: start-litellm.sh's trailing `case`
  # runs on load, and its functions call `exit`.
  if "$LITELLM_SERVICE" start; then
    info "proxy is up."
    return 0
  fi
  warn "could not start the proxy — see $LITELLM_LOG"
  return 1
}

# Serialize cold starts: do_start() has a check-then-act window, so two racing
# invocations would both spawn litellm and leave an orphan on the port.
#
# Close the lock fd before exec. Without that, the harness (and any LiteLLM
# it later starts) inherits the open file and holds the lock for the whole
# session — /cpss-tokenjuice then blocks on flock until start_proxy times out,
# even though a manual start takes a few seconds.
if command -v flock >/dev/null 2>&1 && [[ "$RADNEX_NO_PROXY" != "1" ]]; then
  exec 9>"${TMPDIR:-/tmp}/radnex-proxy.lock"
  flock 9
  ensure_proxy || true
  flock -u 9
  exec 9>&-
else
  ensure_proxy || true
fi

if [[ "$RADNEX_REQUIRE_PROXY" == "1" ]] && ! port_answers; then
  die "proxy is not healthy on :${LITELLM_PORT} and RADNEX_REQUIRE_PROXY=1."
fi

# --- hand off ----------------------------------------------------------------

# Make the package importable regardless of the caller's cwd.
export PYTHONPATH="$RADNEX_ROOT${PYTHONPATH:+:$PYTHONPATH}"

# Exported so the harness can find this launcher again. After a launch-time
# update replaces the code, __main__ re-execs *through this script* rather than
# straight to the interpreter, so the dependency sync above runs against the
# requirements.txt the update just pulled. Without the export it would have to
# guess the path.
export RADNEX_ROOT="${RADNEX_ROOT:-$RADNEX_ROOT}"
export RADNEX_ROOT="$RADNEX_ROOT"

# exec: no extra bash layer, so exit status, signal delivery and TTY ownership
# all belong to the harness. NOTE: exec discards EXIT traps.
exec "$PY" -m radnex "$@"
